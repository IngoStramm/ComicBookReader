<Window x:Class="ComicBookReader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ComicBookReader" Width="1000" Height="760" MinWidth="640" MinHeight="480"
        Background="#151719" Foreground="#F3F3F3"
        FontFamily="Segoe UI" FontSize="14" AllowDrop="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="Background" Value="#303438" />
      <Setter Property="Foreground" Value="#F3F3F3" />
      <Setter Property="BorderBrush" Value="#636970" />
    </Style>
  </Window.Resources>
  <Grid x:Name="Root">
    <Canvas x:Name="Viewport" Margin="12" ClipToBounds="True" Focusable="True"
            Background="#151719" AutomationProperties.Name="Área de leitura">
      <Image x:Name="Page" Stretch="Fill" IsHitTestVisible="False"
             RenderOptions.BitmapScalingMode="HighQuality" />
    </Canvas>
    <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="ComicBookReader" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Text="Abra uma HQ para começar a leitura" Foreground="#B8BEC4" Margin="0,12,0,20" />
      <Button Content="_Abrir HQ…" Click="OpenClicked" ToolTip="Abrir CBZ ou CBR (Ctrl+O)" />
      <TextBlock Text="Você também pode arrastar um arquivo para esta janela." Foreground="#B8BEC4" Margin="0,16,0,0" />
    </StackPanel>
    <Border x:Name="Toolbar" Background="#ED24282C" VerticalAlignment="Top" Margin="12" Padding="8">
      <WrapPanel>
        <Button Content="_Abrir…" Click="OpenClicked" ToolTip="Ctrl+O" />
        <Button Content="‹" Click="PreviousClicked" ToolTip="Página anterior (Page Up)" AutomationProperties.Name="Página anterior" />
        <TextBlock x:Name="PageLabel" Text="Nenhuma HQ aberta" VerticalAlignment="Center" Margin="12,0" />
        <Button Content="›" Click="NextClicked" ToolTip="Próxima página (Page Down)" AutomationProperties.Name="Próxima página" />
        <Button Content="Página _inteira" Click="OverviewClicked" ToolTip="Ver página inteira / retornar (V)" />
        <Button Content="−" Click="SmallerClicked" AutomationProperties.Name="Diminuir largura de leitura" />
        <TextBlock x:Name="WidthLabel" Text="Largura: 100%" VerticalAlignment="Center" Margin="6,0" />
        <Button Content="+" Click="LargerClicked" AutomationProperties.Name="Aumentar largura de leitura" />
        <ComboBox x:Name="ClassificationChoice" SelectedIndex="0" SelectionChanged="ClassificationChanged"
                  Margin="8,0" MinWidth="110" VerticalContentAlignment="Center" AutomationProperties.Name="Tipo de página">
          <ComboBoxItem Content="Automática" />
          <ComboBoxItem Content="Simples" />
          <ComboBoxItem Content="Dupla" />
        </ComboBox>
        <Button Content="_Tela cheia" Click="FullscreenClicked" ToolTip="F11" />
      </WrapPanel>
    </Border>
    <Border Background="#ED24282C" VerticalAlignment="Bottom" HorizontalAlignment="Left"
            Margin="12" Padding="10,6" MaxWidth="600">
      <TextBlock x:Name="Status" Text="Ctrl+O · Abrir HQ    F11 · Tela cheia"
                 TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </Border>
  </Grid>
</Window>
