<Window x:Class="ComicBookReader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ComicBookReader" Icon="Assets/comic-reader.ico" Width="1000" Height="760" MinWidth="640" MinHeight="480"
        Background="#151719" Foreground="#F3F3F3"
        FontFamily="Segoe UI" FontSize="14" AllowDrop="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="Background" Value="#303438" />
      <Setter Property="Foreground" Value="#F3F3F3" />
      <Setter Property="BorderBrush" Value="#636970" />
    </Style>
  </Window.Resources>
  <Grid x:Name="Root">
    <Canvas x:Name="Viewport" Margin="12" ClipToBounds="True" Focusable="True"
            Background="#151719" AutomationProperties.Name="{DynamicResource ReadingArea}">
      <Image x:Name="Page" Stretch="Fill" IsHitTestVisible="False"
             RenderOptions.BitmapScalingMode="HighQuality" />
    </Canvas>
    <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock Text="ComicBookReader" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Text="{DynamicResource EmptyHeading}" Foreground="#B8BEC4" Margin="0,12,0,20" />
      <Button Content="{DynamicResource OpenButton}" Click="OpenClicked" ToolTip="{DynamicResource OpenTip}" />
      <TextBlock Text="{DynamicResource DropHint}" Foreground="#B8BEC4" Margin="0,16,0,0" />
      <TextBlock Text="{DynamicResource ToolbarHint}" Foreground="#B8BEC4" Margin="0,12,0,0" />
    </StackPanel>
    <Border x:Name="Toolbar" Background="#ED24282C" VerticalAlignment="Top" Margin="12" Padding="8">
      <WrapPanel>
        <Button Content="{DynamicResource OpenButton}" Click="OpenClicked" ToolTip="{DynamicResource OpenTip}" />
        <Button Content="‹" Click="PreviousClicked" ToolTip="{DynamicResource PreviousPageTip}" AutomationProperties.Name="{DynamicResource PreviousPage}" />
        <TextBlock x:Name="PageLabel" Text="Nenhuma HQ aberta" VerticalAlignment="Center" Margin="12,0" />
        <Button Content="›" Click="NextClicked" ToolTip="{DynamicResource NextPageTip}" AutomationProperties.Name="{DynamicResource NextPage}" />
        <Button Content="{DynamicResource OverviewButton}" Click="OverviewClicked" ToolTip="{DynamicResource OverviewTip}" />
        <Button Content="−" Click="SmallerClicked" ToolTip="{DynamicResource ZoomOutTip}" AutomationProperties.Name="{DynamicResource ZoomOut}" />
        <TextBlock x:Name="WidthLabel" Text="Largura: 100%" VerticalAlignment="Center" Margin="6,0" />
        <Button Content="+" Click="LargerClicked" ToolTip="{DynamicResource ZoomInTip}" AutomationProperties.Name="{DynamicResource ZoomIn}" />
        <ComboBox x:Name="ClassificationChoice" SelectedIndex="0" SelectionChanged="ClassificationChanged"
                  DropDownClosed="ReadingSelectorClosed"
                  Margin="8,0" MinWidth="110" VerticalContentAlignment="Center" Foreground="#151719" AutomationProperties.Name="{DynamicResource Classification}" ToolTip="{DynamicResource Classification}">
          <ComboBoxItem Content="{DynamicResource Auto}" />
          <ComboBoxItem Content="{DynamicResource Single}" />
          <ComboBoxItem Content="{DynamicResource Spread}" />
        </ComboBox>
        <ComboBox x:Name="ReadingDirectionChoice" SelectedIndex="0" SelectionChanged="ReadingDirectionChanged"
                  DropDownClosed="ReadingSelectorClosed" Margin="8,0" MinWidth="220"
                  VerticalContentAlignment="Center" Foreground="#151719"
                  AutomationProperties.Name="{DynamicResource ReadingDirection}" ToolTip="{DynamicResource ReadingDirection}">
          <ComboBoxItem Content="{DynamicResource LeftToRight}" />
          <ComboBoxItem Content="{DynamicResource RightToLeft}" />
        </ComboBox>
        <Button Content="{DynamicResource FullscreenButton}" Click="FullscreenClicked" ToolTip="{DynamicResource FullscreenTip}" />
        <Button Content="{DynamicResource PreferencesButton}" Click="PreferencesClicked" ToolTip="{DynamicResource PreferencesTip}" />
        <Button Content="{DynamicResource AboutButton}" Click="AboutClicked" />
        <Button x:Name="DefaultWidthButton" Content="{DynamicResource ResetWidthButton}" Click="ResetWidthClicked" ToolTip="{DynamicResource ResetWidthTip}" />
        <Button Content="{DynamicResource ToolbarButton}" Click="HideToolbarClicked" ToolTip="{DynamicResource ToggleToolbarTip}" />
      </WrapPanel>
    </Border>
    <Button x:Name="ToolbarRevealButton" Content="☰" Click="HideToolbarClicked"
            HorizontalAlignment="Right" VerticalAlignment="Top" Width="36" Height="36" Margin="12"
            ToolTip="{DynamicResource ToggleToolbarTip}" AutomationProperties.Name="{DynamicResource ToggleToolbar}" />
    <Border x:Name="StatusPanel" Background="#ED24282C" VerticalAlignment="Bottom" HorizontalAlignment="Left"
            Margin="12" Padding="10,6" MaxWidth="600">
      <TextBlock x:Name="Status" Text="Ctrl+O · Abrir HQ    F11 · Tela cheia"
                 TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </Border>
  </Grid>
</Window>
